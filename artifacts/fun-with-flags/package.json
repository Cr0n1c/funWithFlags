{
  "name": "@workspace/fun-with-flags",
  "version": "2.0.0",
  "description": "Retro CRT terminal front end for the Fun With Flags CTF",
  "author": "Brandon Helms",
  "contributors": [
    "George Merlocco <george@merloc.co>"
  ],
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cr0n1c/funWithFlags.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/apply-lifo-patch.mjs",
    "dev": "vite",
    "build": "node scripts/apply-lifo-patch.mjs --check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:clipboard": "node scripts/test-clipboard.mjs",
    "test:idle-matrix": "node scripts/test-idle-matrix.mjs"
  },
  "dependencies": {
    "@csstools/normalize.css": "^12.1.1",
    "@lifo-sh/core": "0.10.18",
    "jquery": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/jquery": "^4.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "playwright": "^1.63.0",
    "sass-embedded": "^1.90.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
