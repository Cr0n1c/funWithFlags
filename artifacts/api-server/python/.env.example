# Deployment configuration for the API. Every value is read from the process
# environment; nothing here is hardcoded in the application.
#
# The app does not load this file itself. Copy it to `.env` (git-ignored), fill it
# in, and export it through your process manager, container runtime, or shell:
#   set -a && . ./.env && set +a
#
# Use separate values per environment. Keep secrets in a secret manager, never in git.

# --- Runtime -----------------------------------------------------------------
# development | production | test
ENVIRONMENT=development
# Port the API listens on.
PORT=8000

# --- App origin ---------------------------------------------------------------
# Public HTTPS origin of the UI. Used for post-login redirects and CORS.
APP_BASE_URL=https://flags.example.test

# --- Okta SAML single sign-on -------------------------------------------------
# IdP sign-on endpoint that the login redirect is sent to.
SAML_IDP_SSO_URL=https://idp.example.test/app/your-app/your-app-id/sso/saml
# Exact issuer from the IdP metadata.
SAML_IDP_ENTITY_ID=http://www.okta.com/your-app-id
# IdP signing certificate (PEM). Public trust material, not a secret.
SAML_IDP_CERT=
# Optional second certificate during rotation.
SAML_IDP_ROLLOVER_CERT=
# Service-provider identity for this environment.
SAML_SP_ENTITY_ID=https://flags.example.test/saml
# Must be exactly APP_BASE_URL + /api/auth/saml/acs
SAML_ACS_URL=https://flags.example.test/api/auth/saml/acs
# Optional paired SP signing material. The private key is a secret.
SAML_SP_CERT=
SAML_SP_PRIVATE_KEY=
# Comma-separated stable NameIDs granted administrator access.
SAML_ADMIN_SUBJECTS=
SAML_REQUIRED_ATTRIBUTES=

# --- Local development only ----------------------------------------------------------
# Signs in a fixed local administrator without an IdP. Startup fails unless
# ENVIRONMENT=development, APP_BASE_URL is a localhost origin, and SAML is unset.
LOCAL_DEV_LOGIN=false

# --- Secrets (at least 32 characters each) -------------------------------------
SESSION_SECRET=
FLAG_HASH_SECRET=

# --- Database -------------------------------------------------------------------
DATABASE_URL=postgresql://funwithflags@localhost:5432/funwithflags

# --- Optional -------------------------------------------------------------------
# Comma-separated stable subjects hidden from the scoreboard.
SCOREBOARD_EXCLUDED_SUBJECTS=
SLACK_ACTIVITY_WEBHOOK_URL=
SLACK_ACTIVITY_ENABLED=false
