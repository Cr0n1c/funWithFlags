{
  "name": "fun-with-flags-ui",
  "version": "2.0.0",
  "description": "Retro CRT terminal front end for the Fun With Flags CTF",
  "author": "Brandon Helms",
  "contributors": [
    "George Merlocco <george@merloc.co>"
  ],
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/semgrep/funWithFlags.git"
  },
