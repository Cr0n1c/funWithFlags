    "eslint": "^10.11.0",
    "globals": "^17.0.0",
    "sass-embedded": "^1.90.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.1"
  }
