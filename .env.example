# Copy to .env for docker compose. Never commit .env.
# The Helm chart takes the same variable names via values/Secrets.

# --- Okta (required) ---------------------------------------------------------
# Custom authorization server: https://<org>.okta.com/oauth2/default
# Org authorization server:    https://<org>.okta.com
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Must match a "Sign-in redirect URI" on the Okta app integration exactly.
OKTA_REDIRECT_URI=http://localhost:8080/api/auth/callback
# Requires a "groups" scope/claim on the authorization server (see README).
OKTA_SCOPES=openid profile email groups
OKTA_GROUPS_CLAIM=groups
OKTA_USERNAME_CLAIM=preferred_username
# Optional: enables Okta global sign-out redirect
# OKTA_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/

# Okta groups whose members get the /api/admin endpoints (comma-separated)
ADMIN_GROUPS=ctf-admins

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
LOG_JSON=false
# Local dev is plain http, so the session cookie cannot be Secure.
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
SUBMIT_RATE_LIMIT_PER_MINUTE=10

# --- Secrets (generate with: openssl rand -hex 32) ---------------------------
SESSION_SECRET=
FLAG_HASH_SECRET=

# --- Database (compose wires DB_HOST/DB_PORT itself) -------------------------
DB_NAME=funwithflags
DB_USER=funwithflags
DB_PASSWORD=
# Alternatively provide one URL and leave DB_* alone:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# --- Local port mapping / challenge file --------------------------------------
UI_HOST_PORT=8080
API_HOST_PORT=8000
DB_HOST_PORT=5432
# CHALLENGES_FILE=./challenges.yaml
